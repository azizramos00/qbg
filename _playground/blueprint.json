{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.1",
		"wp": "latest"
	},
	"login": true,
	"features": {
		"networking": true
	},
	"plugins": [
		"create-block-theme",
		"the-events-calendar",
		"ultimate-addons-for-gutenberg",
		"gtranslate",
		"opening-hours",
		"wordpress-importer"
	],
	"steps": [
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Queens Botanical Block Theme"
			}
		},
		{
			"step": "updateUserMeta",
			"meta": {
				"admin_color": "modern"
			},
			"userId": 1
		},
		{
			"step": "installTheme",
			"themeZipFile": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/azizramos00/qbg/main/_playground/queens-botanical-block-theme.zip"
			}
		},
		{
			"step": "activateTheme",
			"themeFolderName": "queens-botanical-block-theme"
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; update_option( 'spectra_onboarding', array( 'completed' => true ) ); update_option( '__uagb_do_redirect', false ); ?>"
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; $seed = get_template_directory() . '/_playground/seed-demo-content.php'; if ( is_readable( $seed ) ) { require $seed; } ?>",
			"progress": {
				"weight": 3,
				"caption": "Creating sample pages and posts…"
			}
		},
		{
			"step": "login",
			"username": "admin"
		}
	]
}
