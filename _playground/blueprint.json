{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/site-editor.php",
	"preferredVersions": {
		"php": "8.0",
		"wp": "latest"
	},
	"login": true,
	"steps": [
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Queens Botanical Block Theme"
			}
		},
		{
			"step": "updateUserMeta",
			"meta": {
				"admin_color": "modern"
			},
			"userId": 1
		},
		{
			"step": "installTheme",
			"themeZipFile": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/azizramos00/qbg/main/_playground/queens-botanical-block-theme.zip"
			}
		},
		{
			"step": "activateTheme",
			"themeFolderName": "queens-botanical-block-theme"
		},
		{
			"step": "installPlugin",
			"pluginZipFile": {
				"resource": "wordpress.org/plugins",
				"slug": "create-block-theme"
			},
			"progress": {
				"weight": 2
			}
		}
	]
}