{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "queens-botanical-block/nyc-temperature",
	"version": "1.0.0",
	"title": "NYC temperature",
	"category": "widgets",
	"icon": "thermometer",
	"description": "Current air temperature in New York City (National Weather Service, Central Park station).",
	"keywords": [ "weather", "temperature", "NYC", "New York" ],
	"textdomain": "queens-botanical-block",
	"supports": {
		"html": false,
		"align": true,
		"anchor": true,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"text": true,
			"background": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		}
	},
	"attributes": {
		"unit": {
			"type": "string",
			"default": "fahrenheit"
		},
		"showLocationLabel": {
			"type": "boolean",
			"default": true
		},
		"showAttribution": {
			"type": "boolean",
			"default": true
		}
	},
	"example": {
		"attributes": {
			"unit": "fahrenheit",
			"showLocationLabel": true,
			"showAttribution": true
		}
	},
	"editorScript": "file:./editor.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
